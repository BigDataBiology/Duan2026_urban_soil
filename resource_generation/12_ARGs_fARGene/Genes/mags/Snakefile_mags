import glob, os
import numpy as np

sample_run_file = glob.glob("data/faa/*.faa.gz")
runs_sizes = [os.stat(x).st_size for x in sample_run_file]
sample_run_file_np = np.array(sample_run_file)
runs_sizes_np = np.array(runs_sizes)
#sample_run_file_2 = sample_run_file_np[runs_sizes_np <= np.percentile(runs_sizes_np, 90)].tolist()
sample_run_file_2 = sample_run_file_np.copy()
runs2 = [f.split("/")[-1] for f in sample_run_file_2 ]
runs = [f.split("/")[-1] for f in sample_run_file_2 ]

class_ab = ["class_a","class_b1_b2","class_b3","class_c","class_d1","class_d2"] + \
           ["mph","erm_1","erm_2","tet_enzyme","tet_rpg","aph2b","aph3p","aph6p"]+ \
           ["aac2p", "aac3_1", "aac3_2", "aac6p_1", "aac6p_2", "aac6p_3", "tet_efflux","qnr"]

abricate_db = ["resfinder", "card", "argannot", "ncbi", "megares"]


work_dir ="/work/microbiome/users/juan/UrbanSoil/Genes/mags"
data_dir = "data/faa/"

models = ["class_a", "class_b_1_2", "class_b_3", "class_c","class_d_1","class_d_2"] +\
         ["mph", "erm_type_a", "erm_type_f", "tet_enzyme", "tet_rpg", "aminoglycoside_model_g","aminoglycoside_model_h","aminoglycoside_model_i"] +\
         ["aminoglycoside_model_a","aminoglycoside_model_b","aminoglycoside_model_c","aminoglycoside_model_d","aminoglycoside_model_e","aminoglycoside_model_f", "tet_efflux","qnr"]

model_class = dict(zip(class_ab, models))

rule all:
    input:
        reads_fargene_out = expand(work_dir+"/fargene_results/{runs}-{class_ab}.tsv", runs=runs, class_ab=class_ab),
        genes_fargene_out = expand(work_dir+"/fargene_predicted/{runs}-{class_ab}.fasta", runs=runs, class_ab=class_ab),
        hmm_fargene_out = expand(work_dir+"/fargene_hmm/{runs}-{class_ab}_hmm.txt", runs=runs, class_ab=class_ab),

rule fargene:
    input:
        comp_file1 = expand(data_dir+"{{runs}}", runs=runs)
    output:
        out1_fargene = expand(work_dir+"/fargene_results/{{runs}}-{{class_ab}}.tsv", runs=runs, class_ab=class_ab),
        out2_fargene = expand(work_dir+"/fargene_predicted/{{runs}}-{{class_ab}}.fasta", runs=runs, class_ab=class_ab),
        out3_fargene = expand(work_dir+"/fargene_hmm/{{runs}}-{{class_ab}}_hmm.txt", runs=runs, class_ab=class_ab)
    params:
        num_of_processes = 8,
        model = lambda wildcards: model_class[wildcards.class_ab],
        data_dir = data_dir
    threads: 1
    shadow: "minimal"
    conda:
        "fargene"
    shell:
        """
        echo $CONDA_PREFIX
        echo "fargene  {wildcards.runs} class {params.model}"
        if [ {params.model} == "none" ]; then
          echo "no class given"
        else
          if [ -s {params.data_dir}{wildcards.runs} ]; then
            gunzip < {params.data_dir}{wildcards.runs} > tmp.fasta
            echo "running fargene"
            fargene -i tmp.fasta --protein --hmm-model {params.model} -o tmp_fargene -p {params.num_of_processes} --force
          else
            echo "creating directories"
            mkdir tmp_fargene
            mkdir tmp_fargene/tmpdir
            mkdir tmp_fargene/predictedGenes
            mkdir tmp_fargene/hmmsearchresults
            touch tmp_fargene/tmpdir/tmp-positives.out
            touch tmp_fargene/predictedGenes/filtered.fasta
            touch tmp_fargene/hmmsearchresults/a_hmmsearched.out
          fi
          if [ -s tmp_fargene/tmpdir/tmp-positives.out ]; then
            echo "copying positives"
            mod={wildcards.class_ab}
            awk -v ab="$mod" -F' ' '{{print $0, ab}}' tmp_fargene/tmpdir/tmp-positives.out | awk '{{gsub(/ +/, "\t"); print}}' > {output.out1_fargene}
            echo "copying contigs"
            cp tmp_fargene/predictedGenes/*filtered.fasta {output.out2_fargene}
            echo "copying hmm"
            grep -v '^#' tmp_fargene/hmmsearchresults/*hmmsearched.out > {output.out3_fargene}
          else
            echo "creating files"
            touch {output.out1_fargene}
            touch {output.out2_fargene}
            grep -v '^#' tmp_fargene/hmmsearchresults/*hmmsearched.out > {output.out3_fargene}
          fi
        fi
        """
